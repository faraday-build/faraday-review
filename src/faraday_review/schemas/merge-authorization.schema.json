{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faraday-lab.dev/schemas/merge-authorization.schema.json",
  "title": "MergeAuthorization",
  "description": "Merge authorization record emitted alongside a RiskAssessment (Faraday Review Phase 1.7). In Phase 1 merge_authorized is false unconditionally — auto-merge is Phase 4 scope and requires separate founder ratification. The artifact exists now so the authorization surface is contract-stable before any phase is allowed to set it true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repository",
    "pr_number",
    "head_sha",
    "merge_authorized",
    "authorized_by",
    "evaluated_at"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "merge_authorized": { "type": "boolean" },
    "authorized_by": {
      "type": "string",
      "enum": ["faraday-validator", "founder"],
      "description": "Only the Validator and the founder may authorize (authority invariant). Bots never appear here."
    },
    "risk_class": {
      "type": "string",
      "enum": ["green", "yellow", "red", "block"]
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rationale": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" }
  }
}
