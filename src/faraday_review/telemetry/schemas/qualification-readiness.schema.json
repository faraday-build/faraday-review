{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faraday-lab.dev/schemas/local/qualification-readiness.schema.json",
  "title": "QualificationReadiness",
  "description": "Output of `faraday-review readiness` (qualification-readiness/v4): the machine-readable Phase 1 gate report derived from a QualificationLedger. gate.met is adjudicated_qualifying_real_pr_count >= gate.threshold AND gate.escalation_condition.status == pass; the threshold has a hard floor of 20. The count criterion (including D9 released-digest binding) was confirmed by the founder on 2026-11-14; the same ruling (O1, O2+gate) computes agreement, escalation and founder_latency over the adjudicated qualifying PRs, adds escalation_accuracy and the escalation condition, and keeps the pre-O1 figures under context_all_adjudicated / context_all_real_prs, never gating. real_pr_count keeps its v2 meaning and the v2 criterion is reported as gate.superseded_criterion, never authoritative. Synthetic PRs never count.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "generated_at", "real_pr_count", "qualifying_real_pr_count", "adjudicated_qualifying_real_pr_count", "qualification", "counted_prs", "synthetic_excluded", "adjudicated_count", "agreement", "escalation", "escalation_accuracy", "founder_latency", "context_all_adjudicated", "context_all_real_prs", "drift", "anomalies", "evidence", "gate"],
  "$defs": {
    "class": { "enum": ["green", "yellow", "red", "block"] },
    "count": { "type": "integer", "minimum": 0 },
    "bounds": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 } } },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "exclusion": { "enum": ["unknown", "misconfigured", "refused", "infrastructure_blocked", "policy_digest_unverified"] },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["green", "yellow", "red", "block"],
      "properties": {
        "green": { "$ref": "#/$defs/count" }, "yellow": { "$ref": "#/$defs/count" },
        "red": { "$ref": "#/$defs/count" }, "block": { "$ref": "#/$defs/count" }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "median_seconds", "p90_seconds"],
      "properties": {
        "n": { "$ref": "#/$defs/count" },
        "median_seconds": { "type": ["number", "null"], "minimum": 0 },
        "p90_seconds": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compared", "agree", "disagree", "agreement_rate", "confusion_matrix", "direction", "disagreements"],
      "properties": {
        "compared": { "$ref": "#/$defs/count" },
        "agree": { "$ref": "#/$defs/count" },
        "disagree": { "$ref": "#/$defs/count" },
        "agreement_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confusion_matrix": {
          "description": "Rows: classifier_class. Columns: founder_classification.",
          "type": "object",
          "additionalProperties": false,
          "required": ["green", "yellow", "red", "block"],
          "properties": {
            "green": { "$ref": "#/$defs/row" }, "yellow": { "$ref": "#/$defs/row" },
            "red": { "$ref": "#/$defs/row" }, "block": { "$ref": "#/$defs/row" }
          }
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["over_escalation", "under_escalation"],
          "properties": {
            "over_escalation": { "$ref": "#/$defs/count" },
            "under_escalation": { "$ref": "#/$defs/count" }
          }
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "pr_number", "head_sha", "classifier_class", "founder_classification", "direction"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "pr_number": { "type": "integer", "minimum": 1 },
              "head_sha": { "type": "string" },
              "classifier_class": { "$ref": "#/$defs/class" },
              "founder_classification": { "$ref": "#/$defs/class" },
              "direction": { "enum": ["over_escalation", "under_escalation"] }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalated_count", "classifier_class_distribution", "pr_too_large_escalations", "api_budget_exceeded_escalations"],
      "properties": {
        "escalated_count": { "$ref": "#/$defs/count" },
        "classifier_class_distribution": { "$ref": "#/$defs/row" },
        "pr_too_large_escalations": { "$ref": "#/$defs/count" },
        "api_budget_exceeded_escalations": { "$ref": "#/$defs/count" }
      }
    },
    "latency_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_adjudicated", "escalated_only"],
      "properties": {
        "all_adjudicated": { "$ref": "#/$defs/latency" },
        "escalated_only": { "$ref": "#/$defs/latency" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": { "name": { "type": "string" }, "sha256": { "$ref": "#/$defs/digest" } }
    }
  },
  "properties": {
    "format": { "const": "faraday-review/qualification-readiness/v4" },
    "generated_at": { "type": "string", "format": "date-time" },
    "real_pr_count": { "$ref": "#/$defs/count", "description": "v2 definition, unchanged: distinct real (repository, PR) with a completed, fresh, identity-eligible run on the current head. Not the gate count." },
    "qualifying_real_pr_count": { "$ref": "#/$defs/count", "description": "Real PRs whose current head has at least one eligible occurrence: completed, fresh, identity-eligible, policy digest verified, a known classifier class, and no blocking reason outside the 'classification' category." },
    "adjudicated_qualifying_real_pr_count": { "$ref": "#/$defs/count", "description": "Qualifying real PRs with an accepted founder adjudication (node_id re-checked at aggregate time) on the exact head of an eligible occurrence. The gate count." },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_prs_in_ledger", "exclusions", "incomplete_prs", "exclusion_precedence"],
      "properties": {
        "real_prs_in_ledger": { "$ref": "#/$defs/count", "description": "Distinct non-synthetic (repository, PR) in the ledger: adjudicated_qualifying_real_pr_count plus the sum of exclusions." },
        "exclusions": {
          "description": "Every real PR outside the gate count, under exactly one kind. incomplete: no completed fresh run on a current head (failed-only, stale-only or identity-ineligible). unadjudicated: qualifying, but no valid founder adjudication on an eligible head. Otherwise the PR's first kind in exclusion_precedence.",
          "type": "object",
          "additionalProperties": false,
          "required": ["incomplete", "unknown", "misconfigured", "refused", "infrastructure_blocked", "policy_digest_unverified", "unadjudicated"],
          "properties": {
            "incomplete": { "$ref": "#/$defs/count" }, "unknown": { "$ref": "#/$defs/count" },
            "misconfigured": { "$ref": "#/$defs/count" }, "refused": { "$ref": "#/$defs/count" },
            "infrastructure_blocked": { "$ref": "#/$defs/count" },
            "policy_digest_unverified": { "$ref": "#/$defs/count" },
            "unadjudicated": { "$ref": "#/$defs/count" }
          }
        },
        "incomplete_prs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "pr_number"],
            "properties": { "repository": { "$ref": "#/$defs/repository" }, "pr_number": { "type": "integer", "minimum": 1 } }
          }
        },
        "exclusion_precedence": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }
      }
    },
    "counted_prs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "pr_number", "head_sha", "review_id", "classifier_class", "adjudicated", "qualification"],
        "properties": {
          "repository": { "$ref": "#/$defs/repository" },
          "pr_number": { "type": "integer", "minimum": 1 },
          "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "review_id": { "type": "string" },
          "classifier_class": { "oneOf": [{ "$ref": "#/$defs/class" }, { "type": "null" }] },
          "adjudicated": { "type": "boolean" },
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "exclusion_reasons"],
            "properties": {
              "status": { "enum": ["adjudicated_qualifying", "unadjudicated", "unknown", "misconfigured", "refused", "infrastructure_blocked", "policy_digest_unverified"] },
              "exclusion_reasons": { "type": "array", "items": { "$ref": "#/$defs/exclusion" }, "description": "Every exclusion found on any candidate occurrence of the current head, sorted; also listed for a qualifying PR." }
            }
          }
        }
      }
    },
    "synthetic_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "pr_number", "reason", "present_in_ledger"],
        "properties": {
          "repository": { "$ref": "#/$defs/repository" },
          "pr_number": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "present_in_ledger": { "type": "boolean" }
        }
      }
    },
    "adjudicated_count": { "$ref": "#/$defs/count", "description": "Counted real PRs with a founder adjudication on the counted head, qualifying or not (context; equals context_all_adjudicated.adjudicated_count)." },
    "agreement": { "$ref": "#/$defs/agreement", "description": "Over the adjudicated qualifying PRs (the gate population), scoring the D10 occurrence (O1)." },
    "escalation": { "$ref": "#/$defs/escalation", "description": "Over the adjudicated qualifying PRs, from the D10 scored occurrence (O1). pr_too_large and api_budget counts stay separate." },
    "escalation_accuracy": {
      "description": "O2 over the adjudicated qualifying PRs. Truth: the founder's adjudicated class requires founder review under the policy digest the scored occurrence was evaluated under (governance-pinned table). Prediction: the scored occurrence's recorded escalation. A PR with either undeterminable is unknown. Rates are null, never 0, when their denominator is 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "matrix", "mandatory_escalations", "missed_escalations", "missed_escalation_prs", "unknown", "unknown_prs", "escalation_recall", "escalation_precision", "unnecessary_escalation_rate", "policy_digests_mapped"],
      "properties": {
        "population": { "const": "adjudicated_qualifying" },
        "matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["true_escalation", "unnecessary_escalation", "missed_escalation", "true_non_escalation"],
          "properties": {
            "true_escalation": { "$ref": "#/$defs/count" }, "unnecessary_escalation": { "$ref": "#/$defs/count" },
            "missed_escalation": { "$ref": "#/$defs/count" }, "true_non_escalation": { "$ref": "#/$defs/count" }
          }
        },
        "mandatory_escalations": { "$ref": "#/$defs/count", "description": "true_escalation + missed_escalation: PRs whose adjudicated class requires founder review." },
        "missed_escalations": { "$ref": "#/$defs/count" },
        "missed_escalation_prs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "pr_number", "head_sha", "classifier_class", "founder_classification"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "pr_number": { "type": "integer", "minimum": 1 },
              "head_sha": { "type": "string" },
              "classifier_class": { "oneOf": [{ "$ref": "#/$defs/class" }, { "type": "null" }] },
              "founder_classification": { "$ref": "#/$defs/class" }
            }
          }
        },
        "unknown": { "$ref": "#/$defs/count" },
        "unknown_prs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "pr_number", "head_sha", "reason"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "pr_number": { "type": "integer", "minimum": 1 },
              "head_sha": { "type": "string" },
              "reason": { "enum": ["policy_mapping_unknown", "prediction_unknown"] }
            }
          }
        },
        "escalation_recall": { "$ref": "#/$defs/rate", "description": "true_escalation / mandatory_escalations." },
        "escalation_precision": { "$ref": "#/$defs/rate", "description": "true_escalation / (true_escalation + unnecessary_escalation)." },
        "unnecessary_escalation_rate": { "$ref": "#/$defs/rate", "description": "unnecessary_escalation / (unnecessary_escalation + true_non_escalation): share of PRs not requiring founder review that were escalated anyway (founder throughput cost)." },
        "policy_digests_mapped": { "type": "array", "items": { "$ref": "#/$defs/digest" } }
      }
    },
    "founder_latency": { "$ref": "#/$defs/latency_pair", "description": "Over the adjudicated qualifying PRs (O1); escalated_only uses the scored occurrence's escalation." },
    "context_all_adjudicated": {
      "description": "Pre-O1 figures over every adjudicated counted PR, qualifying or not. Context only; never used by the gate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudicated_count", "agreement", "founder_latency"],
      "properties": {
        "adjudicated_count": { "$ref": "#/$defs/count" },
        "agreement": { "$ref": "#/$defs/agreement" },
        "founder_latency": { "$ref": "#/$defs/latency_pair" }
      }
    },
    "context_all_real_prs": {
      "description": "Pre-O1 escalation volume over every counted real PR (its representative run). Context only; never used by the gate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["escalation"],
      "properties": { "escalation": { "$ref": "#/$defs/escalation" } }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_bundle_digests", "policy_digest_drift", "policy_digest_unverified_runs", "reviewer_versions", "reviewer_version_drift", "stale_state_counts", "infrastructure_failures"],
      "properties": {
        "policy_bundle_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "policy_digest_drift": { "type": "boolean" },
        "policy_digest_unverified_runs": { "$ref": "#/$defs/count" },
        "reviewer_versions": { "type": "array", "items": { "type": "string" } },
        "reviewer_version_drift": { "type": "boolean" },
        "stale_state_counts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/count" } },
        "infrastructure_failures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failed_runs", "failure_modes", "api_budget_exceeded_runs", "status", "bounds"],
          "properties": {
            "failed_runs": { "$ref": "#/$defs/count", "description": "Distinct failed executions: known identities plus distinct legacy events (the lower bound)." },
            "failure_modes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/count" } },
            "api_budget_exceeded_runs": { "$ref": "#/$defs/count" },
            "status": { "enum": ["exact", "bounded"], "description": "exact: every contributing occurrence has a known execution identity. bounded: a legacy (v0.3.0 or event_id-less) occurrence contributes, so the figures are lower bounds counting distinct events and bounds gives the range." },
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["failed_runs", "api_budget_exceeded_runs"],
              "properties": {
                "failed_runs": { "$ref": "#/$defs/bounds" },
                "api_budget_exceeded_runs": { "$ref": "#/$defs/bounds" }
              }
            }
          }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "items": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" } } }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger", "synthetic", "ledger_inputs"],
      "properties": {
        "ledger": { "$ref": "#/$defs/file" },
        "synthetic": { "$ref": "#/$defs/file" },
        "ledger_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "kind": { "enum": ["telemetry", "adjudications", "decision", "run_binding", "collection_manifest"] },
              "sha256": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "criterion", "criterion_status", "released_policy_digests", "escalation_condition", "met",
                   "superseded_criterion"],
      "properties": {
        "threshold": { "type": "integer", "minimum": 20 },
        "criterion": { "const": "adjudicated_qualifying_real_pr_count >= threshold AND escalation_condition.status == pass" },
        "criterion_status": { "const": "founder_confirmed" },
        "released_policy_digests": {
          "description": "Governance-released policy digests a counted run must have been evaluated under; any other verified digest is misconfigured. null = not enforced (library default only; the CLI always enforces).",
          "type": ["array", "null"],
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "escalation_condition": {
          "description": "O2 gate condition over the adjudicated qualifying PRs. pass: missed == 0 AND unknown == 0 AND mandatory_total > 0. fail: missed > 0. unknown: otherwise; an unknown or zero denominator never passes.",
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "missed", "mandatory_total", "unknown"],
          "properties": {
            "status": { "enum": ["pass", "fail", "unknown"] },
            "missed": { "$ref": "#/$defs/count" },
            "mandatory_total": { "$ref": "#/$defs/count" },
            "unknown": { "$ref": "#/$defs/count" }
          }
        },
        "met": { "type": "boolean" },
        "superseded_criterion": {
          "description": "The v2 criterion, reported so nothing is hidden. Never authoritative.",
          "type": "object",
          "additionalProperties": false,
          "required": ["criterion", "met", "authoritative"],
          "properties": {
            "criterion": { "const": "real_pr_count >= threshold" },
            "met": { "type": "boolean" },
            "authoritative": { "const": false }
          }
        }
      }
    }
  }
}
