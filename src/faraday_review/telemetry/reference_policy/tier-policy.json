{
  "policy": "adr-0014-tier-policy",
  "status": "proposed",
  "adr": "decisions/ADR-0014-risk-tiered-delegated-merge.md",
  "note": "Proposal artifact. Not binding until ADR-0014 is Accepted; activation is separately gated per repository. Promote into schemas/vocabulary/ in a versioned release after ratification.",
  "tiers": [
    "A0",
    "A1",
    "A2",
    "A3",
    "A4"
  ],
  "faraday_review_mapping": {
    "green": {
      "tier": "A0_or_A1",
      "rule": "A0 iff every changed path matches a0_path_set, else A1"
    },
    "yellow": {
      "tier": "A2"
    },
    "red": {
      "tier": "A3"
    },
    "block": {
      "tier": "not_eligible",
      "route": "founder_exception_queue"
    }
  },
  "session_risk_class_mapping": {
    "docs": "A0",
    "standard": "A1",
    "elevated": "A3",
    "critical": "A4"
  },
  "repository_floors": {
    "production_or_deploy_or_customer_data_or_money": "A3",
    "private_without_enforceable_protection": "A3",
    "default": "A0"
  },
  "a0_path_set": [
    "**/*.md",
    "**/*.rst"
  ],
  "a0_path_exclusions": [
    "decisions/**",
    "**/ADR-*.md",
    "governance/**",
    "policy/**",
    ".github/**",
    "review-policy/**",
    "**/*.schema.json",
    "**/schemas/**"
  ],
  "reference_path_tiers": {
    "status": "proposed",
    "purpose": "Independent reference path tier for QA-1 qualification (L1). Not a merge-eligibility rule.",
    "evaluation": "Each changed path (and the previous name of a renamed path) takes A3 if it matches a3_paths; else A0 if it is in a0_path_set and not in a0_path_exclusions; else A1 if it matches a1_paths; else A2. The PR reference tier is the highest path tier, raised to the repository floor. An incomplete file list makes the tier unknown.",
    "glob": "`**/` matches zero or more leading directories, `**` any characters, `*` any characters except `/`; matching is case-sensitive and anchored to the whole path.",
    "a3_paths": [
      ".github/**",
      "**/.github/**",
      "decisions/**",
      "**/ADR-*.md",
      "governance/**",
      "**/governance/**",
      "policy/**",
      "**/policy/**",
      "review-policy/**",
      "**/*.schema.json",
      "schemas/**",
      "**/schemas/**",
      "contracts/**",
      "**/contracts/**",
      "CODEOWNERS",
      "**/CODEOWNERS",
      "**/auth/**",
      "**/auth.*",
      "**/auth_*",
      "**/*_auth.*",
      "**/*oauth*",
      "**/*credential*",
      "**/*secret*",
      "**/*validator*",
      "**/*validator*/**",
      "Dockerfile",
      "**/Dockerfile",
      "**/*.tf",
      "deploy/**",
      "infra/**",
      "**/k8s/**",
      "**/helm/**"
    ],
    "a1_paths": [
      "tests/**",
      "**/tests/**",
      "test/**",
      "**/test/**",
      "**/__tests__/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/*_test.go",
      "**/*.test.*",
      "**/*.spec.*",
      "**/fixtures/**",
      "**/testdata/**"
    ],
    "default": "A2",
    "vectors": "decisions/ADR-0014/reference-tier-vectors.json"
  },
  "a4_operations": [
    "repository_delete_or_transfer",
    "force_push_or_history_rewrite",
    "ruleset_or_branch_protection_change",
    "repository_or_org_permission_change",
    "github_app_permission_change",
    "secret_create_rotate_or_expose",
    "production_deploy_or_data_operation",
    "contract_bundle_release_or_tag",
    "break_glass"
  ],
  "eligibility": {
    "A0": {
      "delegated_merge": "eligible_after_activation",
      "founder_signature": false,
      "extra_independent_review": false,
      "conditions": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8",
        "E9",
        "E10",
        "T12"
      ]
    },
    "A1": {
      "delegated_merge": "eligible_after_activation",
      "founder_signature": false,
      "extra_independent_review": false,
      "conditions": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8",
        "E9",
        "E10",
        "T12"
      ]
    },
    "A2": {
      "delegated_merge": "conditional",
      "founder_signature": true,
      "extra_independent_review": true,
      "conditions": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8",
        "E9",
        "E10"
      ]
    },
    "A3": {
      "delegated_merge": "never",
      "founder_signature": true,
      "extra_independent_review": false,
      "conditions": [
        "required_checks",
        "codex_evidence",
        "founder_decision_bound_to_sha"
      ]
    },
    "A4": {
      "delegated_merge": "never",
      "founder_signature": true,
      "extra_independent_review": false,
      "conditions": [
        "explicit_founder_authorization_per_operation",
        "governance_event"
      ]
    }
  },
  "bot_approve_review": "never",
  "founder_authorization": {
    "adr_section": "6.1",
    "never_authorization": [
      "commit_signature_verified",
      "founder_author_or_committer",
      "founder_account_pushed_or_merged",
      "founder_token_used",
      "founder_account_login",
      "agent_host_credential"
    ],
    "a2_delegation_evidence": [
      "founder_decision_signature"
    ],
    "a3_a4_evidence": [
      "founder_decision_signature",
      "interactive_founder_action",
      "founder_execution_grant"
    ],
    "decision_signature": {
      "namespace": "faraday-merge-go",
      "allowed_signers": "tomrivera-ops/.github:policy/founder-allowed-signers",
      "distinct_from_commit_signing_keys": true,
      "absent_from_agent_hosts": true,
      "key_fingerprint": "SHA256:yhaDzjdnB4aFL11XaMxhjHuTYdLwlQXw6L+rS6BILDE",
      "message_type": "faraday-merge-decision:v2",
      "message_bindings": [
        "repository",
        "action",
        "target",
        "base_sha",
        "head_sha",
        "scope",
        "expires_at",
        "request_id"
      ],
      "rejected_message_types": [
        "faraday-merge-decision:v1"
      ],
      "single_use_request_id": true
    },
    "agent_commit_trailer": "Agent-Commit",
    "d_6_1": "accepted",
    "execution_grant": {
      "issuer_node_id": "U_kgDODk3msA",
      "issued_via": [
        "interactive_founder_instruction",
        "signed_grant"
      ],
      "signed_grant": {
        "namespace": "faraday-exec-grant",
        "payload_type": "faraday-execution-grant",
        "payload_format": "canonical_json",
        "payload_fields": [
          "type",
          "version",
          "founder_node_id",
          "action",
          "repository",
          "target",
          "sha",
          "scope",
          "expires_at",
          "request_id",
          "conditions"
        ],
        "decision_tuple_signature_is_grant": false,
        "allowed_signers_namespace_entry": "separate_founder_action"
      },
      "required_bindings": [
        "founder_identity",
        "action",
        "repository",
        "target",
        "exact_sha",
        "scope",
        "expiry",
        "single_use_request_id"
      ],
      "default_expiry": "end_of_issuing_session",
      "consumed_on_first_attempt": true,
      "recorded_before_execution": true,
      "live_reverify_before_execution": true,
      "agent_may_not": [
        "create",
        "infer",
        "broaden",
        "extend",
        "split",
        "combine",
        "reuse"
      ],
      "not_a_grant": [
        "commit_signature_verified",
        "founder_author_or_committer",
        "founder_account_pushed_or_merged",
        "founder_token_used",
        "shared_host_key",
        "agent_host_credential",
        "founder_account_login",
        "agent_writable_artifact",
        "design_or_policy_direction",
        "authorization_for_different_sha",
        "relayed_or_agent_written_instruction"
      ],
      "delegated_merge": "never",
      "interactive_channel": "founder_own_turn_in_direct_session_channel",
      "relayed_instruction_is_grant": false,
      "relayed_context_accepts": [
        "signed_grant"
      ]
    }
  },
  "ratification": {
    "adr_section": "12",
    "evidence": "founder_ratification_signature",
    "message_type": "agent-contracts-adr-ratification:v1",
    "namespace": "faraday-merge-go",
    "message_bindings": [
      "repository",
      "pr",
      "base_sha",
      "head_sha",
      "adr",
      "status",
      "expires_at",
      "request_id"
    ],
    "recorded_before_merge": true,
    "merge_path_while_adr_0012_binds": "interactive_founder_merge_match_head_commit",
    "not_ratification": [
      "status_line_alone",
      "founder_author_or_committer",
      "founder_account_pushed_or_merged",
      "commit_signature_verified",
      "founder_token_used",
      "founder_account_login",
      "agent_host_credential",
      "agent_prepared_pr"
    ],
    "activates": false
  },
  "fail_closed": "unknown, missing, stale or malformed input => not_eligible",
  "qualification": {
    "min_real_prs": 20,
    "max_green_vs_founder_red_or_block": 0,
    "gate": "faraday-review docs/PHASE_2_INPUTS.md gate v4 (founder adjudication); binding until QA-1 is adopted"
  },
  "qualification_qa1": {
    "status": "proposed",
    "adopted": false,
    "note": "GHO-AUTONOMOUS-PRODUCTION-011 QA-1, approved in principle by the founder 2026-11-15 with refinements. Not active: replaces `qualification` only after formal founder adoption and passing tests. Qualification evidence never authorizes a merge.",
    "min_verified_real_prs": 20,
    "verified_population": "qualifying real PRs whose exact-head independent reference verdict is concordant with Faraday Review, or whose exception or sample the founder answered at that head",
    "max_material_green_under_escalation": 0,
    "max_missed_mandatory_escalations": 0,
    "min_mandatory_escalations": 1,
    "min_verified_green": 5,
    "unknown_reference_counts": false,
    "reference_verdict_is_founder_adjudication": false,
    "founder_answers_only_for": [
      "material_disagreement",
      "block",
      "sample"
    ],
    "mandatory_escalations_route_to": "founder_review_by_tier",
    "sampling": {
      "window_size": 5,
      "green_per_window": 1,
      "additional_per_window": 1,
      "selection": "sha256 rank seeded from GitHub-assigned identifiers of the window's members (first head SHA and first Codex receipt id); reproducible, never operator-chosen"
    },
    "reference_layers": [
      "L1_path_tier",
      "L2_codex_receipt",
      "L3_required_checks",
      "L4_post_merge_outcome"
    ],
    "post_merge_outcome_window_days": 14,
    "post_merge_outcome_is_sole_reference": false,
    "pre_merge_evidence_kept_for_unmerged": true,
    "post_activation_audit_min_rate": 0.1,
    "authorizes_merge": false
  },
  "kill_switch_layers": [
    "adr_status_accepted_on_main",
    "policy_activation_flag",
    "repo_variable_FARADAY_BOT_MERGE_ENABLED"
  ],
  "activation": {
    "enabled": false,
    "repositories": []
  }
}
