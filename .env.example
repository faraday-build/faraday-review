# Faraday Review — environment
# GitHub token used by collection and publication (contents:read,
# pull-requests:write, checks:write). In Actions this is GITHUB_TOKEN.
GITHUB_TOKEN=

# Pinned policy digest from the released governance tag (v1.1.0):
# canonical.bundle_digest over review-policy/ at that tag.
# Absent pin => every evaluation Blocks with policy_digest_unpinned.
FARADAY_POLICY_DIGEST=sha256:32eeb3e07271fff267908bc428d77477caa403d9e0f8b0a0244d8c26aec73e12
